tellraw @s [{"text":"  \u2022 ","color":"#D8C8A0"},{"text":"Your flashlight holds back the fade \u2014 but light makes you seen.","color":"gray"}]
tellraw @s [{"text":"If you are taken, a companion can return to your remnant and remember you back.","color":"gray"}]
