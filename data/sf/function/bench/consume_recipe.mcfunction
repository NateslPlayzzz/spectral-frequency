# consume_recipe.mcfunction — macro; counts come straight from the recipe object
$clear @s minecraft:iron_ingot $(iron)
$clear @s minecraft:redstone $(redstone)
$clear @s minecraft:glass $(glass)
$clear @s minecraft:amethyst_shard[custom_data={}] $(amethyst)
$clear @s minecraft:slime_ball[custom_data~{sf:{material:"ectoplasm"}}] $(ecto)
$clear @s minecraft:amethyst_shard[custom_data~{sf:{material:"veil_shard"}}] $(shard)