{
  "type": "minecraft:multi_action",
  "title": {
    "text": "EQUIPMENT REQUISITION",
    "color": "#D8C8A0",
    "bold": true
  },
  "external_title": {
    "text": "Equipment Requisition",
    "color": "#D8C8A0"
  },
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "UMBRA FIELD LOGISTICS // LOSS AND DAMAGE",
        "color": "#6A6A78",
        "bold": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "Every Investigator receives two emergency recovery claims for missing calibration instruments.",
        "color": "gray"
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "The Investigator's Guidebook, Field Radio, and Resonance Key are access equipment. Missing copies are reissued without consuming a claim.",
        "color": "#5AC8C8",
        "italic": true
      }
    },
    {
      "type": "minecraft:plain_message",
      "contents": {
        "text": "A claim is consumed only when one or more missing calibration instruments are restored. After both claims are used, replacements must be assembled through an Attuned Bench.",
        "color": "#FFC36B",
        "italic": true
      }
    }
  ],
  "inputs": [],
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "close",
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "EMERGENCY RECOVERY",
        "color": "#9BFFB0",
        "bold": true
      },
      "tooltip": "Review and confirm the use of one emergency recovery claim.",
      "action": {
        "type": "run_command",
        "command": "/trigger sf.signal set 13"
      }
    },
    {
      "label": {
        "text": "AUDIT CURRENT FIELD KIT",
        "color": "#5AC8C8"
      },
      "tooltip": "Review access equipment, calibration instruments, and remaining claims.",
      "action": {
        "type": "run_command",
        "command": "/trigger sf.signal set 11"
      }
    },
    {
      "label": {
        "text": "ATTUNED BENCH POLICY",
        "color": "#C89BFF"
      },
      "tooltip": "Review assembly divisions, materials, and restricted formulas.",
      "action": {
        "type": "run_command",
        "command": "/trigger sf.signal set 12"
      }
    },
    {
      "label": {
        "text": "BACK TO FIELD RADIO",
        "color": "#8A8A98"
      },
      "action": {
        "type": "run_command",
        "command": "/trigger sf.signal set 6"
      }
    },
    {
      "label": {
        "text": "CLOSE CHANNEL",
        "color": "#6A6A78"
      },
      "action": {
        "type": "run_command",
        "command": "/trigger sf.signal set 4"
      }
    }
  ]
}